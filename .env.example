PORT=3000
NODE_ENV=development
# Supabase PostgreSQL connection string (Pooler or Direct Postgres URI)
# When unset, Nexus HRM falls back to a local SQLite database for development.
DATABASE_URL=
SUPABASE_DB_URL=
# Supabase Auth (client + server JWT verification)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Gemini HR Assistant (server-only secret; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional HRM workspace settings
HRM_DB_PATH=
HRM_ADMIN_EMAIL=
HRM_ADMIN_PASSCODE=