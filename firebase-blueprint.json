{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated workspace member profile stored in Firestore with strict owner/admin PII isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full display name of the signed-in user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified email address of the user (PII)."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Optional department label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Multi-turn Gemini HR Assistant conversation session owned by a user.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the session owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Short summary title for the conversation."
        },
        "persona": {
          "type": "string",
          "enum": ["hr_advisor", "payroll_specialist", "quick_assistant"],
          "description": "Active Gemini HR role persona."
        },
        "model": {
          "type": "string",
          "enum": ["gemini-4-hydrogen", "gemini-3.1-flash-lite"],
          "description": "Gemini model used for this session."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Lifecycle state; archived is terminal for non-admins."
        },
        "messageCount": {
          "type": "integer",
          "description": "Total number of messages stored in this session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerUid", "title", "persona", "model", "status", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single immutable message turn within a Gemini HR Assistant chat session.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the parent session owner."
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent ChatSession document ID."
        },
        "sender": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Message author role."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "description": "Markdown message content."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Model identifier that produced or processed the turn."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["ownerUid", "sessionId", "sender", "content", "model", "createdAt"]
    },
    "HrNote": {
      "title": "HrNote",
      "description": "Personal HR compliance or payroll follow-up note pinned from the workspace or assistant.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the note owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Note heading."
        },
        "category": {
          "type": "string",
          "enum": ["Policy", "Payroll", "Compliance", "General"],
          "description": "HR domain category."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Note content."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"],
          "description": "Completion state; resolved is terminal for non-admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerUid", "title", "category", "body", "status", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted server/admin-managed lookup document granting elevated Firestore admin access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Administrator email address."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to the profile owner and verified admins."
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Multi-turn Gemini HR Assistant chat sessions owned by the parent user."
    },
    "/users/{userId}/chatSessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Append-only conversation turns belonging to an active parent chat session."
    },
    "/users/{userId}/hrNotes/{noteId}": {
      "schema": { "$ref": "#/entities/HrNote" },
      "description": "Personal HR compliance and payroll notes saved by the user."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted RBAC admin allowlist collection managed strictly by verified admins."
    }
  }
}
